# Database Configuration
DB_SA_PASSWORD=YourStrongPassword123!

# Connection Strings
IDENTITY_CONNECTION_STRING=Server=mssql;Database=IdentityDb;User Id=sa;Password=YourStrongPassword123!;TrustServerCertificate=True;Encrypt=False
ENTITY_CONNECTION_STRING=Server=mssql;Database=EntityDb;User Id=sa;Password=YourStrongPassword123!;TrustServerCertificate=True;Encrypt=False

# RabbitMQ Configuration
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=YourRabbitMQPassword123!
RABBITMQ_HOST=amqp://admin:YourRabbitMQPassword123!@rabbitmq:5672

# Redis Configuration
REDIS_PASSWORD=YourRedisPassword123!
REDIS_CONNECTION_STRING=redis:6379,password=YourRedisPassword123!

# Email Configuration (Gmail example)
EMAIL_FROM=noreply.sciconnect@gmail.com
EMAIL_DISPLAY_NAME=SciConnect Notifications
EMAIL_PASSWORD=your-app-specific-password
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_SSL=false
EMAIL_USE_STARTTLS=true

# Docker Registry (optional - leave empty for local builds)
DOCKER_REGISTRY=

# Domain Configuration (update with your actual domain)
DOMAIN=yourdomain.com
